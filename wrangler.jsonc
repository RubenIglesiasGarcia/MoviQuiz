{
  "name": "mobiquiz",
  "main": "worker.js",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/icons/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mobiquiz-db",
      "database_id": "4225588f-360f-41e4-92ec-9920f9404d7d"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    }
  ],
  "keep_vars": true
}
