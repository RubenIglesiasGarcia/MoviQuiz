{
  "name": "mobiquiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "wrangler dev",
    "dev": "wrangler dev",
    "check": "node --check worker.js && node --check game.js && node --check public/app.js && node --check public/sw.js && node --check src/ui.js && node --check scripts/build-ui.mjs && node --check public/avatar.js && node --check public/cast.js && node --check src/character3d.js && node --check public/progression.js && node --check public/effects.js",
    "test": "node --test",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "build:ui": "node scripts/build-ui.mjs",
    "postinstall": "npm run build:ui"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "google-auth-library": "^9.15.1",
    "jose": "^6.1.0",
    "lit": "^3.3.1",
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.34.0"
  }
}
